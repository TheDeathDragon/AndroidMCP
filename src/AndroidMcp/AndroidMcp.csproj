<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AndroidMcp</RootNamespace>
    <AssemblyName>android-mcp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AdvancedSharpAdbClient" Version="3.6.16" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AndroidMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\agent-server.jar" Link="tools\agent-server.jar">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCountRaw" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHashRaw" />
    </Exec>
    <PropertyGroup>
      <GitCommitCount Condition="'$(_GitCommitCountRaw)' != ''">$(_GitCommitCountRaw.Trim())</GitCommitCount>
      <GitCommitCount Condition="'$(GitCommitCount)' == ''">0</GitCommitCount>
      <GitHash Condition="'$(_GitHashRaw)' != ''">$(_GitHashRaw.Trim())</GitHash>
      <GitHash Condition="'$(GitHash)' == ''">nogit</GitHash>
      <YearMonth>$([System.DateTime]::Now.ToString(yyMM))</YearMonth>
      <PaddedCount>$([System.String]::Format('{0:0000}', $([System.Convert]::ToInt32($(GitCommitCount)))))</PaddedCount>
      <BuildVersion>$(YearMonth).$(PaddedCount)</BuildVersion>
      <BuildTimeUtc>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</BuildTimeUtc>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Include="// &lt;auto-generated /&gt;" />
      <_BuildInfoLines Include="namespace AndroidMcp%3B" />
      <_BuildInfoLines Include="internal static class BuildInfo" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    public const string Version = &quot;$(BuildVersion)&quot;%3B" />
      <_BuildInfoLines Include="    public const string GitHash = &quot;$(GitHash)&quot;%3B" />
      <_BuildInfoLines Include="    public const string BuildTimeUtc = &quot;$(BuildTimeUtc)&quot;%3B" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(_BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
      <FileWrites Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
